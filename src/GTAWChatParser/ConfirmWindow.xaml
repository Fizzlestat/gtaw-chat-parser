<Window x:Class="GTAWChatParser.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Are you sure?"
        Width="460" Height="198"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0"
        Loaded="Window_Loaded">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1" CornerRadius="10">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="12"/>
        </Border.RenderTransform>
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="Are you sure?" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" MouseLeftButtonDown="Drag"/>
            <TextBlock x:Name="MessageText" Grid.Row="1" Text="The current chat log is saved before the parser closes." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource HudButton}" Width="112" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Content="Close" Style="{StaticResource HudPrimaryButton}" Width="124" IsDefault="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
