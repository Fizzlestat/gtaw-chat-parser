<Window x:Class="GTAWChatParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GTAWChatParser"
        Title="GTA: World Chat Parser"
        Width="1180" Height="760"
        MinWidth="1020" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                <Grid x:Name="Header" Background="{DynamicResource BackgroundBrush}" MouseLeftButtonDown="Header_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mark: three chat lines, the last one "caught" -->
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource FrameBrush}" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Canvas Width="22" Height="22">
                            <Path Data="M 6,7.5 H 16" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M 6,11 H 12" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.55"/>
                            <Path Data="M 6,14.5 H 14" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,12,0" IsHitTestVisible="False">
                        <TextBlock Text="GTA: World" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Chat Parser" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <Border BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1,6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" FontFamily="{DynamicResource TranscriptFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource ChromeButton}" ToolTip="{local:Loc tooltipMinimize}" AutomationProperties.Name="{local:Loc tooltipMinimize}" Click="Minimize_Click">
                            <Path Data="M 0,0.5 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="2"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" ToolTip="{local:Loc tooltipTray}" AutomationProperties.Name="{local:Loc tooltipTray}" Click="Tray_Click" Margin="2,0,0,0">
                            <Canvas Width="12" Height="12">
                                <Path Data="M 0.7,7.5 V 11.3 H 11.3 V 7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="M 6,0.7 V 7 M 3.4,4.6 L 6,7.2 L 8.6,4.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Button>
                        <Button Style="{StaticResource CloseChromeButton}" ToolTip="{local:Loc tooltipClose}" AutomationProperties.Name="{local:Loc tooltipClose}" Click="Close_Click" Margin="2,0,0,0">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Transcript -->
                <Grid Grid.Column="0" Background="{DynamicResource TranscriptBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="22,0,20,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Ellipse x:Name="StatusHalo" Fill="{Binding Fill, ElementName=StatusDot}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="StatusHaloScale" ScaleX="1" ScaleY="1"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="StatusDot" Fill="{DynamicResource IdleBrush}"/>
                                </Grid>
                                <TextBlock x:Name="StatusText" Text="Starting" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{local:Loc transcriptHeading}" Style="{StaticResource Eyebrow}"/>
                        </DockPanel>
                    </Border>

                    <!-- Empty state: a flat signal line waiting for something to happen -->
                    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                        <Canvas Width="240" Height="40" HorizontalAlignment="Center" Margin="0,0,0,26">
                            <Path Data="M 0,20 H 96 L 104,20 L 110,8 L 118,32 L 124,20 H 240" Stroke="{DynamicResource HairlineStrongBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse x:Name="EmptyBlip" Width="7" Height="7" Fill="{DynamicResource FrameBrush}" Canvas.Left="236.5" Canvas.Top="16.5"/>
                        </Canvas>
                        <TextBlock Text="{local:Loc transcriptEmpty}" TextWrapping="Wrap" MaxWidth="420" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" FontSize="13" LineHeight="20"/>
                    </StackPanel>

                    <FlowDocumentScrollViewer x:Name="ChatView" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             FontFamily="{DynamicResource TranscriptFont}" FontSize="14" Foreground="{DynamicResource LineBrush}"
                             SelectionBrush="{DynamicResource FrameBrush}"
                             Visibility="Collapsed" SizeChanged="ChatView_SizeChanged" Focusable="True">
                        <FlowDocumentScrollViewer.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{local:Loc transcriptCopy}" Command="ApplicationCommands.Copy"/>
                                <MenuItem Header="{local:Loc transcriptSelectAll}" Command="ApplicationCommands.SelectAll"/>
                            </ContextMenu>
                        </FlowDocumentScrollViewer.ContextMenu>
                        <FlowDocument x:Name="ChatDocument" Background="Transparent" PagePadding="22,14,16,20"
                                      FontFamily="{DynamicResource TranscriptFont}" FontSize="14" Foreground="{DynamicResource LineBrush}"/>
                    </FlowDocumentScrollViewer>

                    <!-- Floating notice -->
                    <Border x:Name="NoticeBar" Grid.Row="1" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,22,22" MaxWidth="620"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10,16,10">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NoticeSlide" Y="10"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black"/>
                        </Border.Effect>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="3" CornerRadius="1.5" Background="{DynamicResource FrameBrush}" Margin="0,1,12,1"/>
                            <TextBlock x:Name="NoticeText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Settings -->
                <Border Grid.Column="1" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="50" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                            <TextBlock Text="{local:Loc settingsHeading}" Style="{StaticResource Eyebrow}"/>
                        </Border>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="20,14,20,16">
                            <Button Content="{local:Loc buttonExit}" Style="{StaticResource HudButton}" Click="Exit_Click"/>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <!-- 01 Keywords -->
                                <Border Style="{StaticResource SectionRule}">
                                    <StackPanel>
                                        <Border x:Name="KeywordsHeader" Style="{StaticResource SectionHeader}" MouseLeftButtonUp="KeywordsHeader_Click" MouseEnter="Header_MouseEnter" MouseLeave="Header_MouseLeave">
                                            <Border.Background><SolidColorBrush Color="#00000000"/></Border.Background>
                                            <DockPanel>
                                                <TextBlock x:Name="KeywordsIndex" Text="01" Style="{StaticResource SectionIndex}"/>
                                                <Path x:Name="KeywordsChevron" DockPanel.Dock="Right" Style="{StaticResource SectionGlyph}">
                                                    <Path.RenderTransform><RotateTransform x:Name="KeywordsAngle" Angle="45"/></Path.RenderTransform>
                                                </Path>
                                                <TextBlock Text="{local:Loc sectionKeywords}" Style="{StaticResource SectionTitle}"/>
                                            </DockPanel>
                                        </Border>
                                        <Border x:Name="KeywordsBody" Style="{StaticResource SectionBody}">
                                            <Border.LayoutTransform><ScaleTransform x:Name="KeywordsScale" ScaleY="1"/></Border.LayoutTransform>
                                            <StackPanel>
                                                <TextBlock Text="{local:Loc keywordsHint}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="KeywordsBox" Style="{StaticResource HudField}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="128" MaxHeight="200"/>
                                                <Button Content="{local:Loc buttonSaveKeywords}" Style="{StaticResource HudPrimaryButton}" Margin="0,12,0,0" Click="SaveKeywords_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 02 Logs -->
                                <Border Style="{StaticResource SectionRule}">
                                    <StackPanel>
                                        <Border x:Name="LogsHeader" Style="{StaticResource SectionHeader}" MouseLeftButtonUp="LogsHeader_Click" MouseEnter="Header_MouseEnter" MouseLeave="Header_MouseLeave">
                                            <Border.Background><SolidColorBrush Color="#00000000"/></Border.Background>
                                            <DockPanel>
                                                <TextBlock x:Name="LogsIndex" Text="02" Style="{StaticResource SectionIndex}"/>
                                                <Path x:Name="LogsChevron" DockPanel.Dock="Right" Style="{StaticResource SectionGlyph}">
                                                    <Path.RenderTransform><RotateTransform x:Name="LogsAngle" Angle="0"/></Path.RenderTransform>
                                                </Path>
                                                <TextBlock Text="{local:Loc sectionLogs}" Style="{StaticResource SectionTitle}"/>
                                            </DockPanel>
                                        </Border>
                                        <Border x:Name="LogsBody" Style="{StaticResource SectionBody}" Opacity="0" Visibility="Collapsed">
                                            <Border.LayoutTransform><ScaleTransform x:Name="LogsScale" ScaleY="0"/></Border.LayoutTransform>
                                            <StackPanel>
                                                <Border Style="{StaticResource Well}" Padding="11,9" Margin="0,0,0,8">
                                                    <TextBlock x:Name="FolderText" FontFamily="{DynamicResource TranscriptFont}" FontSize="12" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                </Border>
                                                <TextBlock Text="{local:Loc logsFormat}" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                                    <Button Content="{local:Loc buttonChangeFolder}" Style="{StaticResource HudButton}" Margin="0,0,4,0" Click="ChangeFolder_Click"/>
                                                    <Button Content="{local:Loc buttonOpenFolder}" Style="{StaticResource HudButton}" Margin="4,0,0,0" Click="OpenFolder_Click"/>
                                                </UniformGrid>
                                                <Button Content="{local:Loc buttonSaveLog}" Style="{StaticResource HudPrimaryButton}" Click="SaveLog_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 03 Notifications -->
                                <Border Style="{StaticResource SectionRule}">
                                    <StackPanel>
                                        <Border x:Name="NotificationsHeader" Style="{StaticResource SectionHeader}" MouseLeftButtonUp="NotificationsHeader_Click" MouseEnter="Header_MouseEnter" MouseLeave="Header_MouseLeave">
                                            <Border.Background><SolidColorBrush Color="#00000000"/></Border.Background>
                                            <DockPanel>
                                                <TextBlock x:Name="NotificationsIndex" Text="03" Style="{StaticResource SectionIndex}"/>
                                                <Path x:Name="NotificationsChevron" DockPanel.Dock="Right" Style="{StaticResource SectionGlyph}">
                                                    <Path.RenderTransform><RotateTransform x:Name="NotificationsAngle" Angle="0"/></Path.RenderTransform>
                                                </Path>
                                                <TextBlock Text="{local:Loc sectionNotifications}" Style="{StaticResource SectionTitle}"/>
                                            </DockPanel>
                                        </Border>
                                        <Border x:Name="NotificationsBody" Style="{StaticResource SectionBody}" Opacity="0" Visibility="Collapsed">
                                            <Border.LayoutTransform><ScaleTransform x:Name="NotificationsScale" ScaleY="0"/></Border.LayoutTransform>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,14">
                                                    <CheckBox x:Name="NotificationsToggle" Style="{StaticResource HudToggle}" DockPanel.Dock="Right" Checked="Notifications_Changed" Unchecked="Notifications_Changed"/>
                                                    <TextBlock Text="{local:Loc labelNotifications}" Style="{StaticResource RowLabel}"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,14">
                                                    <CheckBox x:Name="CaseToggle" Style="{StaticResource HudToggle}" DockPanel.Dock="Right" Checked="Notifications_Changed" Unchecked="Notifications_Changed"/>
                                                    <TextBlock Text="{local:Loc labelCaseSensitive}" Style="{StaticResource RowLabel}"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,18">
                                                    <TextBlock Text="{local:Loc labelSeconds}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
                                                    <Border DockPanel.Dock="Right" Width="52" Height="30" Style="{StaticResource InputWell}">
                                                        <TextBox x:Name="SecondsBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource FrameBrush}" FontFamily="{DynamicResource TranscriptFont}" TextAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="13" LostFocus="Seconds_Commit" PreviewKeyDown="Seconds_KeyDown"/>
                                                    </Border>
                                                    <TextBlock Text="{local:Loc labelDuration}" Style="{StaticResource RowLabel}"/>
                                                </DockPanel>

                                                <TextBlock Text="{local:Loc labelAnimation}" Style="{StaticResource FieldLabel}"/>
                                                <Border Background="{DynamicResource TranscriptBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="7" Padding="3" Margin="0,0,0,20">
                                                    <UniformGrid Columns="3">
                                                        <Button x:Name="SlideButton" Content="{local:Loc animationSlide}" Style="{StaticResource HudChoiceSelectedButton}" Click="Animation_Click"/>
                                                        <Button x:Name="PopButton" Content="{local:Loc animationPop}" Style="{StaticResource HudChoiceButton}" Margin="3,0" Click="Animation_Click"/>
                                                        <Button x:Name="NoneButton" Content="{local:Loc animationNone}" Style="{StaticResource HudChoiceButton}" Click="Animation_Click"/>
                                                    </UniformGrid>
                                                </Border>

                                                <DockPanel Margin="0,0,0,10">
                                                    <CheckBox x:Name="SoundToggle" Style="{StaticResource HudToggle}" DockPanel.Dock="Right" Checked="Notifications_Changed" Unchecked="Notifications_Changed"/>
                                                    <TextBlock Text="{local:Loc labelSound}" Style="{StaticResource RowLabel}"/>
                                                </DockPanel>
                                                <TextBlock Text="{local:Loc soundHint}" Style="{StaticResource FieldLabel}"/>
                                                <Border Style="{StaticResource Well}" Padding="11,0" Height="34" Margin="0,0,0,8">
                                                    <DockPanel>
                                                        <Canvas DockPanel.Dock="Left" Width="14" Height="12" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <Path Data="M 1,2 V 10 M 4.5,0 V 12 M 8,3.5 V 8.5 M 11.5,5 V 7" Stroke="{DynamicResource FrameBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        </Canvas>
                                                        <TextBlock x:Name="SoundFileText" Text="Default" FontFamily="{DynamicResource TranscriptFont}" FontSize="12" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                                <UniformGrid Columns="3">
                                                    <Button Content="{local:Loc buttonChoose}" Style="{StaticResource HudButton}" Margin="0,0,4,0" Click="ChooseSound_Click"/>
                                                    <Button Content="{local:Loc buttonPlay}" Style="{StaticResource HudButton}" Margin="4,0" Click="PreviewSound_Click"/>
                                                    <Button Content="{local:Loc buttonDefault}" Style="{StaticResource HudButton}" Margin="4,0,0,0" Click="ResetSound_Click"/>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 04 Customization -->
                                <Border Style="{StaticResource SectionRule}">
                                    <StackPanel>
                                        <Border x:Name="AppearanceHeader" Style="{StaticResource SectionHeader}" MouseLeftButtonUp="AppearanceHeader_Click" MouseEnter="Header_MouseEnter" MouseLeave="Header_MouseLeave">
                                            <Border.Background><SolidColorBrush Color="#00000000"/></Border.Background>
                                            <DockPanel>
                                                <TextBlock x:Name="AppearanceIndex" Text="04" Style="{StaticResource SectionIndex}"/>
                                                <Path x:Name="AppearanceChevron" DockPanel.Dock="Right" Style="{StaticResource SectionGlyph}">
                                                    <Path.RenderTransform><RotateTransform x:Name="AppearanceAngle" Angle="0"/></Path.RenderTransform>
                                                </Path>
                                                <TextBlock Text="{local:Loc sectionCustomization}" Style="{StaticResource SectionTitle}"/>
                                            </DockPanel>
                                        </Border>
                                        <Border x:Name="AppearanceBody" Style="{StaticResource SectionBody}" Opacity="0" Visibility="Collapsed">
                                            <Border.LayoutTransform><ScaleTransform x:Name="AppearanceScale" ScaleY="0"/></Border.LayoutTransform>
                                            <StackPanel>
                                                <TextBlock Text="{local:Loc labelPrimary}" Style="{StaticResource FieldLabel}"/>
                                                <local:HudColorWell x:Name="PrimaryWell" Margin="0,0,0,18" ColorEdited="ColorWell_Edited" ColorCommitted="ColorWell_Committed"/>
                                                <TextBlock Text="{local:Loc labelSecondary}" Style="{StaticResource FieldLabel}"/>
                                                <local:HudColorWell x:Name="SecondaryWell" Margin="0,0,0,18" ColorEdited="ColorWell_Edited" ColorCommitted="ColorWell_Committed"/>
                                                <TextBlock Text="{local:Loc labelInterfaceFont}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="UiFontBox" Style="{StaticResource HudCombo}" Margin="0,0,0,12" SelectionChanged="Font_Changed"/>
                                                <TextBlock Text="{local:Loc labelTranscriptFont}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="TranscriptFontBox" Style="{StaticResource HudCombo}" Margin="0,0,0,16" SelectionChanged="Font_Changed"/>
                                                <Button Content="{local:Loc buttonResetAppearance}" Style="{StaticResource HudButton}" Click="ResetAppearance_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 05 Application -->
                                <Border Style="{StaticResource SectionRule}">
                                    <StackPanel>
                                        <Border x:Name="StartupHeader" Style="{StaticResource SectionHeader}" MouseLeftButtonUp="StartupHeader_Click" MouseEnter="Header_MouseEnter" MouseLeave="Header_MouseLeave">
                                            <Border.Background><SolidColorBrush Color="#00000000"/></Border.Background>
                                            <DockPanel>
                                                <TextBlock x:Name="StartupIndex" Text="05" Style="{StaticResource SectionIndex}"/>
                                                <Path x:Name="StartupChevron" DockPanel.Dock="Right" Style="{StaticResource SectionGlyph}">
                                                    <Path.RenderTransform><RotateTransform x:Name="StartupAngle" Angle="0"/></Path.RenderTransform>
                                                </Path>
                                                <TextBlock Text="{local:Loc sectionApplication}" Style="{StaticResource SectionTitle}"/>
                                            </DockPanel>
                                        </Border>
                                        <Border x:Name="StartupBody" Style="{StaticResource SectionBody}" Opacity="0" Visibility="Collapsed">
                                            <Border.LayoutTransform><ScaleTransform x:Name="StartupScale" ScaleY="0"/></Border.LayoutTransform>
                                            <StackPanel>
                                                <TextBlock Text="{local:Loc labelLanguage}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="LanguageBox" Style="{StaticResource HudCombo}" Margin="0,0,0,18" SelectionChanged="Language_Changed"/>
                                                <DockPanel Margin="0,0,0,14">
                                                    <CheckBox x:Name="StartupToggle" Style="{StaticResource HudToggle}" DockPanel.Dock="Right" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                                                    <TextBlock Text="{local:Loc labelStartWithWindows}" Style="{StaticResource RowLabel}"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,14">
                                                    <CheckBox x:Name="TrayStartupToggle" Style="{StaticResource HudToggle}" DockPanel.Dock="Right" IsEnabled="False" Checked="TrayStartup_Changed" Unchecked="TrayStartup_Changed"/>
                                                    <TextBlock x:Name="TrayStartupLabel" Text="{local:Loc labelStartMinimized}" Style="{StaticResource RowLabel}" Opacity="0.45"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,18">
                                                    <CheckBox x:Name="UpdateToggle" Style="{StaticResource HudToggle}" DockPanel.Dock="Right" Checked="UpdateCheck_Changed" Unchecked="UpdateCheck_Changed"/>
                                                    <TextBlock Text="{local:Loc labelCheckUpdates}" Style="{StaticResource RowLabel}"/>
                                                </DockPanel>
                                                <Button Content="{local:Loc buttonCheckUpdates}" Style="{StaticResource HudButton}" HorizontalAlignment="Left" Click="CheckUpdates_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
